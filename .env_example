# Root-level environment variables for docker-compose

# Conductor Configuration
CONDUCTOR_PORT=3000

# Frontend Configuration
FRONTEND_PORT=19006
# Browser/API origin (public conductor). Same URL from any network. Never localhost.
EXPO_PUBLIC_API_URL=https://cloudapi.aerekos.com
PUBLIC_API_URL=https://cloudapi.aerekos.com

# Worker Configuration
WORKER_PORT=3001
WORKER_TOKEN=  # Set this after getting registration token from conductor

# Development
NODE_ENV=development

