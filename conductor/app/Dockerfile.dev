# Development Dockerfile for Expo web
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy app source
COPY . .

# Expose Expo dev server port
EXPOSE 19006

# Same-origin /api proxy on 19006 → conductor; Expo listens on 19007 inside the container.
CMD ["node", "web-proxy.js"]
