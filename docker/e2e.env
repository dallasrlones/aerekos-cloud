# Used by: docker/e2e-compose.yml, scripts/e2e-docker.sh, npm run e2e:docker:up
# Intentionally odd host ports to avoid clashing with typical local services (3000, 3001, 5432, …)

COMPOSE_PROJECT_NAME=aerekos-e2e

AEREKOS_CONDUCTOR_PORT=38470
AEREKOS_WORKER_PORT=38471

# Conductor and worker must agree: registration token the worker uses as CONDUCTOR_TOKEN
WORKER_REGISTRATION_TOKEN=e2e0b000-0000-4000-8000-0000000e2e00

# e2e-docker.sh only: login when neither AUTH_TOKEN nor AUTH_PASSWORD is set (matches conductor seed)
E2E_DEFAULT_AUTH_USERNAME=admin
E2E_DEFAULT_AUTH_PASSWORD=admin
