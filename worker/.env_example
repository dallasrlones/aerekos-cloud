# Conductor Configuration
# Public conductor — same URL from any network. Never a private IP.
CONDUCTOR_URL=https://cloudapi.aerekos.com
# Registration token: copy it from the conductor (Settings → Registration Token,
# or the conductor's WORKER_REGISTRATION_TOKEN). Must match exactly.
CONDUCTOR_TOKEN=

# Worker Configuration
# Device info (hostname, IP, CPU, RAM, disk, network) is auto-detected:
#   - `./up.sh` (or `make worker` from the repo root) runs detect-host-resources.sh
#     and writes .worker-host.env for the most accurate values on any OS.
#   - Even with a bare `docker compose up`, the entrypoint detects host specs from
#     the mounted /proc + /sys.
# To override any value manually, set WORKER_HOSTNAME / WORKER_IP / WORKER_CPU_CORES
# / WORKER_RAM_GB / WORKER_DISK_GB / WORKER_NETWORK_MBPS here.

# Optional: Intervals (defaults shown)
HEARTBEAT_INTERVAL=5
RESOURCE_CHECK_INTERVAL=60

# Worker API Configuration
PORT=3001

# Optional: durable log buffer → conductor (logs_manager via proxy) when back online
# LOG_SPOOL=1
# LOG_SHIP_BEARER=<JWT or service token accepted by /api/services/*/api>
# LOG_SHIP_PROJECT_ID=<project uuid>
# LOG_OUTBOX_PATH=  # default: ./data/worker_log_outbox.db
# LOG_SHIP_INTERVAL_MS=5000
# LOG_SHIP_BATCH=80
