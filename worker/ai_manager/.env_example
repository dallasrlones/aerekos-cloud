# Copy to .env (gitignored)
PORT=3126
SERVICE_NAME=ai_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development

# Conductor registration (skip in unit/integration tests)
# CONDUCTOR_URL=http://host.docker.internal:3000
# SKIP_SERVICE_REGISTRATION=true

# LLM backends (inference needs at least one reachable URL)
# LLM_BACKEND=ollama
# OLLAMA_HOST=http://host.docker.internal:11434
# VLLM_HOST=http://host.docker.internal:8000
# VLLM_DEFAULT_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit

# Auth peer for app JWT verify
# AUTH_MANAGER_URL=http://host.docker.internal:3116

# Memory (homelab default: sqlite fallback)
# MEMORY_DB_FALLBACK=1
# DATABASE_PATH=./data/ai_manager.db

# Voice sidecars (Orin / GPU host)
# STT_URL=http://host.docker.internal:8090
# TTS_URL=http://host.docker.internal:8880

# LoRA trainer sidecar (compose)
# LORA_BASE_MODEL=
# LORA_MAX_STEPS=100

# Test / local skips
# SKIP_JOB_CONSUMER=1
# SKIP_BROKER=1
# SKIP_CRON=1
# SKIP_RESUME=1
