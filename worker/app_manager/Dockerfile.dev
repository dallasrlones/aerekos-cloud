FROM node:20-bookworm-slim
WORKDIR /app/app_manager
COPY app_manager/package*.json ./
RUN npm install
COPY app_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3125 NODE_ENV=development NODE_PATH=/app/app_manager/node_modules
EXPOSE 3125
CMD ["node", "index.js"]
