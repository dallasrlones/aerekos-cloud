# Copy to .env (gitignored)
PORT=3116
SERVICE_NAME=auth_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# DATABASE_PATH=./data/auth_manager.db

# Conductor registration (optional locally)
# CONDUCTOR_URL=http://host.docker.internal:3000
# SKIP_SERVICE_REGISTRATION=true

# Signing secret — prefer key_manager via secrets_manager (auth_manager.signing_secret).
# Env values are boot fallbacks only; not production mocks.
# AUTH_MANAGER_SECRET=
# JWT_SECRET=
# AUTH_MANAGER_SECRET_NAME=auth_manager.signing_secret

# Conductor client_credentials peer secret (KMS name conductor.client_secret)
# CONDUCTOR_CLIENT_SECRET=
# CONDUCTOR_CLIENT_SECRET_NAME=conductor.client_secret

# Extra static clients: [{"id":"ci","secret":"...","scopes":["*"]}]
# AUTH_CLIENTS=
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=

# AUTH_TOKEN_TTL_SECONDS=3600
# APP_TOKEN_TTL_SECONDS=3600
# AUTH_USER_TOKEN_TTL_SECONDS=604800
