FROM node:20-bookworm-slim
WORKDIR /app/auth_manager
COPY auth_manager/package*.json ./
RUN npm install
COPY auth_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3116 NODE_ENV=development NODE_PATH=/app/auth_manager/node_modules
EXPOSE 3116
CMD ["node", "index.js"]
