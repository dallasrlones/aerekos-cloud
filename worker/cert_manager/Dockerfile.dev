FROM node:20-bookworm-slim
WORKDIR /app/cert_manager
COPY cert_manager/package*.json ./
RUN npm install
COPY cert_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3137 NODE_ENV=development NODE_PATH=/app/cert_manager/node_modules
EXPOSE 3137
CMD ["node", "index.js"]
