FROM node:20-bookworm-slim
WORKDIR /app/cicd_manager
COPY cicd_manager/package*.json ./
RUN npm install
COPY cicd_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3119 NODE_ENV=development NODE_PATH=/app/cicd_manager/node_modules
EXPOSE 3119
CMD ["node", "index.js"]
