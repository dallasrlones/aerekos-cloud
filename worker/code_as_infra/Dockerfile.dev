FROM node:20-bookworm-slim
WORKDIR /app/code_as_infra
COPY code_as_infra/package*.json ./
RUN npm install
COPY code_as_infra/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3120 NODE_ENV=development NODE_PATH=/app/code_as_infra/node_modules
EXPOSE 3120
CMD ["node", "index.js"]
