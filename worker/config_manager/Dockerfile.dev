FROM node:20-bookworm-slim
WORKDIR /app/config_manager
COPY config_manager/package*.json ./
RUN npm install
COPY config_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3136 NODE_ENV=development NODE_PATH=/app/config_manager/node_modules
EXPOSE 3136
CMD ["node", "index.js"]
