FROM node:20-bookworm-slim
WORKDIR /app/crawler_manager
COPY crawler_manager/package*.json ./
RUN npm install
COPY crawler_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3121 NODE_ENV=development NODE_PATH=/app/crawler_manager/node_modules
EXPOSE 3121
CMD ["node", "index.js"]
