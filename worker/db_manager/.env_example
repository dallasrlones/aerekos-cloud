# Service Identity
SERVICE_NAME=db_manager
SERVICE_VERSION=1.0.0
PORT=3004

# Conductor Connection
CONDUCTOR_URL=http://conductor:3000
SERVICE_TOKEN=  # Will be obtained during registration

# Key Manager (REQUIRED for encryption)
KEY_MANAGER_URL=http://conductor:3000/api/services/key_manager
MOCK_KEY_MANAGER=false  # Set to true for development without key_manager

# Database (SQLite for db_manager metadata)
DATABASE_PATH=/app/data/db_manager.db

# Worker Connection (for Docker container management)
WORKER_URL=http://worker:3001

# Default Database Settings
DEFAULT_DB_TYPE=postgresql
MAX_INSTANCES_PER_WORKER=10
DEFAULT_DB_PORT_START=5432

# Backup Settings
BACKUP_ENABLED=true
BACKUP_INTERVAL=24  # hours
STORAGE_MANAGER_URL=http://conductor:3000/api/services/storage_manager

# Logging
LOG_LEVEL=info
NODE_ENV=development
