FROM node:20-bookworm-slim
WORKDIR /app/db_manager
COPY db_manager/package*.json ./
RUN npm install
COPY db_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3004 NODE_ENV=development NODE_PATH=/app/db_manager/node_modules
EXPOSE 3004
CMD ["node", "index.js"]
