# Copy to .env (gitignored)
PORT=3111
SERVICE_NAME=domain_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# CONDUCTOR_URL=http://host.docker.internal:3000
# SKIP_SERVICE_REGISTRATION=true
#
# Cloudflare (when implementing) — use least-privilege API tokens; prefer secrets_manager / key_manager in prod:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=   (optional, for some account-scoped API calls)
# Default zone (optional if single-zone deploy):
# CLOUDFLARE_ZONE_ID=
#
# Local dev: skip API calls, mock cf_record_id
# SKIP_CLOUDFLARE=1
# SQLite path (default: ./data/domain_manager.db under the service)
# DATABASE_PATH=
