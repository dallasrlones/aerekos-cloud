# Copy to .env (gitignored)
PORT=3111
SERVICE_NAME=domain_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# DATABASE_PATH=./data/domain_manager.db
# CONDUCTOR_URL=http://host.docker.internal:3000
# SKIP_SERVICE_REGISTRATION=true
#
# Cloudflare — prefer secrets_manager / key_manager in prod; never commit tokens:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=   # optional default zone for hostname→CNAME pairing
#
# SKIP_CLOUDFLARE=1   # test/dev only — forbidden when NODE_ENV=production (assertNoSkipFakes)
