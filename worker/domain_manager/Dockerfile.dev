FROM node:20-bookworm-slim
WORKDIR /app/domain_manager
COPY domain_manager/package*.json ./
RUN npm install
COPY domain_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3111 NODE_ENV=development NODE_PATH=/app/domain_manager/node_modules
EXPOSE 3111
CMD ["node", "index.js"]
