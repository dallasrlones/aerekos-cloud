# Copy to .env (gitignored)
PORT=3133
SERVICE_NAME=download_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# DATABASE_PATH=./data/download_manager.db
# CONDUCTOR_URL=http://host.docker.internal:3000
# SERVICE_TOKEN=
# SKIP_SERVICE_REGISTRATION=true
# SKIP_DOWNLOAD=1   # test/dev only — forbidden when NODE_ENV=production (assertNoSkipFakes)
# SKIP_TORRENT=1    # test/dev only — forbidden when NODE_ENV=production (extra)
# DISABLE_TICKER=1
# TICK_INTERVAL_MS=30000
# QBITTORRENT_URL=http://localhost:8080
# QBITTORRENT_USER=admin
# QBITTORRENT_PASS=
# QBITTORRENT_SAVE_ROOT=/data
# DOWNLOAD_MEDIA_DIR=
# YT_OUTPUT_DIR=
# MAX_CONCURRENT=2
