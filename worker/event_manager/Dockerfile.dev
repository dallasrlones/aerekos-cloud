FROM node:20-bookworm-slim
WORKDIR /app/event_manager
COPY event_manager/package*.json ./
RUN npm install
COPY event_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3132 NODE_ENV=development NODE_PATH=/app/event_manager/node_modules
EXPOSE 3132
CMD ["node", "index.js"]
