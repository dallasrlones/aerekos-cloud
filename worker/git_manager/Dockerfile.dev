# Generated by worker/scripts/standardize-dockerfiles.mjs — do not hand-edit.
# Build context MUST be the worker/ directory.
FROM node:20-bookworm-slim
WORKDIR /app/git_manager
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY git_manager/package*.json ./
RUN npm install
COPY git_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3130 NODE_ENV=development NODE_PATH=/app/git_manager/node_modules
EXPOSE 3130
CMD ["node", "index.js"]
