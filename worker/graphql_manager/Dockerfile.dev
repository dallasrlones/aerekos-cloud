FROM node:20-bookworm-slim
WORKDIR /app/graphql_manager
COPY graphql_manager/package*.json ./
RUN npm install
COPY graphql_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3141 NODE_ENV=development NODE_PATH=/app/graphql_manager/node_modules
EXPOSE 3141
CMD ["node", "index.js"]
