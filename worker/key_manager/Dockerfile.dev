FROM node:20-bookworm-slim
WORKDIR /app/key_manager
COPY key_manager/package*.json ./
RUN npm install
COPY key_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3002 NODE_ENV=development NODE_PATH=/app/key_manager/node_modules
EXPOSE 3002
CMD ["node", "index.js"]
