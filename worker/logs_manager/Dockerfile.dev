FROM node:20-bookworm-slim
WORKDIR /app/logs_manager
COPY logs_manager/package*.json ./
RUN npm install
COPY logs_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3104 NODE_ENV=development NODE_PATH=/app/logs_manager/node_modules
EXPOSE 3104
CMD ["node", "index.js"]
