{
  "name": "metrics_manager",
  "version": "1.0.0",
  "description": "Metrics Manager — aerekos-cloud worker service",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "NODE_PATH=./node_modules jest",
    "test:watch": "NODE_PATH=./node_modules jest --watch",
    "test:coverage": "NODE_PATH=./node_modules jest --coverage",
    "test:integration": "NODE_PATH=./node_modules jest --testPathPattern=tests/integration",
    "test:unit": "NODE_PATH=./node_modules jest --testPathPattern=tests/unit",
    "test:e2e": "echo \"See tests/e2e/README.md — run against live stack\""
  },
  "keywords": [
    "aerekos-cloud",
    "metrics_manager"
  ],
  "license": "ISC",
  "dependencies": {
    "aerekos-record": "^0.1.4",
    "axios": "^1.6.0",
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
