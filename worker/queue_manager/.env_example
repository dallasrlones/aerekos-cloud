# Copy to .env (gitignored)
PORT=3101
# SQLite store (per worker node)
# DATABASE_PATH=./data/queue_manager.db
SERVICE_NAME=queue_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# CONDUCTOR_URL=http://host.docker.internal:3000
# SKIP_SERVICE_REGISTRATION=true

# Data plane (default sqlite = real persistence). Do NOT use local_nats in production.
# AEREKOS_QUEUE_PROVIDER=sqlite
# AEREKOS_QUEUE_PROVIDER=local_nats

# Broker engines (unset SKIP_BROKER and provide URLs for rabbitmq / redis_stream)
# SKIP_BROKER=1
# RABBITMQ_URL=amqp://aerekos:aerekos@rabbitmq:5672
# REDIS_URL=redis://redis:6379
