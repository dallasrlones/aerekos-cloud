# Copy to .env (gitignored)
PORT=3129
SERVICE_NAME=registry_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# CONDUCTOR_URL=http://host.docker.internal:3000
# SKIP_SERVICE_REGISTRATION=true
#
# Labels for GET /api/v1/registry/config (optional; worker pulls use full image ref from conductor)
# REGISTRY_MODE=local|docker_hub|harbor|embedded|custom
# REGISTRY_PUBLIC_BASE_URL=         (e.g. https://harbor.example.com — display only)
# REGISTRY_DEFAULT_NAMESPACE=       (e.g. aerekos)
# REGISTRY_AUTH_EXPECTED=1          (hint: workers need docker login)
