# Generated by worker/scripts/standardize-dockerfiles.mjs — do not hand-edit.
# Build context MUST be the worker/ directory:
#   docker build -f registry_manager/Dockerfile -t aerekos-registry_manager worker/
FROM node:20-bookworm-slim
WORKDIR /app/registry_manager
COPY registry_manager/package*.json ./
RUN npm install --omit=dev && npm cache clean --force
COPY registry_manager/ ./
# shared/ holds simplePrometheusMetrics + logOutbox used via require('../shared/..')
COPY shared /app/shared
# aerekos-record bundles a macOS better-sqlite3 binary; re-fetch the Linux prebuild.
RUN npm rebuild better-sqlite3
ENV PORT=3129
ENV NODE_PATH=/app/registry_manager/node_modules
EXPOSE 3129
CMD ["node", "index.js"]
