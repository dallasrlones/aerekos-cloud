# Copy to .env (gitignored)
# PORT 3102 collides with key_manager in managerServicePorts — pick a free PORT for local-only if key is up
PORT=3102
# DATABASE_PATH=./data/schedule_manager.db
# WEBHOOK_TIMEOUT_MS=30000
SERVICE_NAME=schedule_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# Preferred: queue dispatch via conductor → queue_manager
# CONDUCTOR_URL=http://host.docker.internal:3000
# Test/dev only — direct queue base (skips conductor; no localhost default in code)
# QUEUE_MANAGER_URL=http://q.internal:3101
# SKIP_SERVICE_REGISTRATION=true
# SKIP_CRON=1   # tests only — do not use as a production mock
