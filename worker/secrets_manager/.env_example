# Copy to .env (gitignored)
PORT=3107
SERVICE_NAME=secrets_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# CONDUCTOR_URL=http://host.docker.internal:3000
# SERVICE_TOKEN=   (required to call key_manager through conductor, unless MOCK_KEY_MANAGER)
# SECRETS_ENCRYPTION_KEY_NAME=secrets-envelope-key  (project-scoped key in key_manager)
# SKIP_SERVICE_REGISTRATION=true
# Tests / local: envelope crypto without conductor
# MOCK_KEY_MANAGER=true
# MOCK_KEY_MATERIAL=   (64 hex chars for 32-byte AES key, optional)
# DATABASE_PATH=
