FROM node:20-bookworm-slim
WORKDIR /app/slack_manager
COPY slack_manager/package*.json ./
RUN npm install
COPY slack_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3115 NODE_ENV=development NODE_PATH=/app/slack_manager/node_modules
EXPOSE 3115
CMD ["node", "index.js"]
