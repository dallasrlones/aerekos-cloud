FROM node:20-bookworm-slim
WORKDIR /app/status_manager
COPY status_manager/package*.json ./
RUN npm install
COPY status_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3150 NODE_ENV=development NODE_PATH=/app/status_manager/node_modules
EXPOSE 3150
CMD ["node", "index.js"]
