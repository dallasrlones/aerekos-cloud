# Service Identity
SERVICE_NAME=storage_manager
SERVICE_VERSION=1.0.0
PORT=3003

# Conductor
CONDUCTOR_URL=http://localhost:3000
SERVICE_TOKEN=

# Database (via db_manager - fallback to SQLite if not available)
DB_MANAGER_URL=http://localhost:3000/api/services/db_manager
DATABASE_PATH=./data/storage_manager.db

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=10737418240

# Encryption
ENCRYPTION_ENABLED=true
DEFAULT_ENCRYPTION_KEY=storage-encryption-key
# Dev only: stubs keys locally. Must be false (or unset) in production; NODE_ENV=production refuses MOCK_KEY_MANAGER=true.
MOCK_KEY_MANAGER=true
# Optional hex key for mock mode (64 chars); default built-in if unset
# MOCK_KEY_MATERIAL=

# Logging
LOG_LEVEL=info
NODE_ENV=development
