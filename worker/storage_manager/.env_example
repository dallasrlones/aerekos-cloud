# Service Identity
SERVICE_NAME=storage_manager
SERVICE_VERSION=1.0.0
PORT=3003

# Conductor
CONDUCTOR_URL=http://localhost:3000
SERVICE_TOKEN=

# Auth (prod / GA: AUTH_REQUIRED=true). Compose defaults AUTH_REQUIRED=true.
# Routes always require Bearer; auth accepts conductor validate-token OR auth_manager verify.
AUTH_REQUIRED=true
AUTH_MANAGER_URL=http://localhost:3116

# Database (via db_manager - fallback to SQLite if not available)
DB_MANAGER_URL=http://localhost:3000/api/services/db_manager
DATABASE_PATH=./data/storage_manager.db

# Storage (object bytes; not STORAGE_ROOT)
STORAGE_PATH=./storage
MAX_FILE_SIZE=10737418240

# Encryption — real key_manager via conductor in prod. Never MOCK_KEY_MANAGER=true when NODE_ENV=production (process exits).
ENCRYPTION_ENABLED=true
DEFAULT_ENCRYPTION_KEY=storage-encryption-key
MOCK_KEY_MANAGER=false
# Local-only: set MOCK_KEY_MANAGER=true to stub keys without key_manager (tests set this themselves).
# Optional hex key for mock mode (64 chars); default built-in if unset
# MOCK_KEY_MATERIAL=

# Logging
LOG_LEVEL=info
NODE_ENV=development
