FROM node:20-bookworm-slim
WORKDIR /app/storage_manager
COPY storage_manager/package*.json ./
RUN npm install
COPY storage_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3003 NODE_ENV=development NODE_PATH=/app/storage_manager/node_modules
EXPOSE 3003
CMD ["node", "index.js"]
