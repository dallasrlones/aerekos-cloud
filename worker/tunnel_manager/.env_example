# Copy to .env (gitignored)
PORT=3110
SERVICE_NAME=tunnel_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# DATABASE_PATH=./data/tunnel_manager.db
# CONDUCTOR_URL=http://host.docker.internal:3000
# SKIP_SERVICE_REGISTRATION=true
#
# Cloudflare — prefer secrets_manager / key_manager in prod; never commit tokens:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=   # required for live tunnel API (account-scoped)
#
# SKIP_CLOUDFLARE=1   # test/dev only — mock tunnels/tokens; forbidden when NODE_ENV=production (assertNoSkipFakes)
