# Copy to .env (gitignored)
PORT=3110
SERVICE_NAME=tunnel_manager
SERVICE_VERSION=1.0.0
NODE_ENV=development
# CONDUCTOR_URL=http://host.docker.internal:3000
# SKIP_SERVICE_REGISTRATION=true
# CLOUDFLARE_API_TOKEN=
# Account ID (tunnels are account-scoped; required for live API, not in SKIP_CLOUDFLARE dev mode)
# CLOUDFLARE_ACCOUNT_ID=
# Local dev: mock tunnels and return mock tokens; never persist real tunnel tokens
# SKIP_CLOUDFLARE=1
# DATABASE_PATH=
