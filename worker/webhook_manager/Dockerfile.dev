FROM node:20-bookworm-slim
WORKDIR /app/webhook_manager
COPY webhook_manager/package*.json ./
RUN npm install
COPY webhook_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3112 NODE_ENV=development NODE_PATH=/app/webhook_manager/node_modules
EXPOSE 3112
CMD ["node", "index.js"]
