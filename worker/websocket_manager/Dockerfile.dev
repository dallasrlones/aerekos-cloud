FROM node:20-bookworm-slim
WORKDIR /app/websocket_manager
COPY websocket_manager/package*.json ./
RUN npm install
COPY websocket_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3131 NODE_ENV=development NODE_PATH=/app/websocket_manager/node_modules
EXPOSE 3131
CMD ["node", "index.js"]
