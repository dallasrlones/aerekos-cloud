FROM node:20-bookworm-slim
WORKDIR /app/worker_manager
COPY worker_manager/package*.json ./
RUN npm install
COPY worker_manager/ ./
COPY shared /app/shared
RUN npm rebuild better-sqlite3
ENV PORT=3128 NODE_ENV=development NODE_PATH=/app/worker_manager/node_modules
EXPOSE 3128
CMD ["node", "index.js"]
